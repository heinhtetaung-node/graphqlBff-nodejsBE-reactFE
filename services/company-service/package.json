    "@opentelemetry/semantic-conventions": "^1.23.0",
    "knex": "^3.1.0",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "uuid": "^9.0.0"
